# AI-MACT Unified Root Gitignore
# ---------------------------------

# 1. Dependency directories (Explicit & Recursive)
node_modules/
web/node_modules/
server/node_modules/
**/node_modules/**
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# 2. Build outputs (Explicit & Recursive)
.next/
web/.next/
**/dist/**
**/build/**
**/out/**
**/.next/**
**/.serverless/**
**/bin/**
**/obj/**
**/*.tsbuildinfo
**/.vercel/**

# 3. Environment and Secrets (CRITICAL)
**/.env
**/.env*
**/*.pem
**/*.key

# 4. Debug and Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
**/*.log
**/coverage/

# 5. IDE and System settings
**/.vscode/**
**/.idea/**
**/*.swp
**/*.swo
**/.DS_Store
**/Thumbs.db

# 6. Oracle DB related
**/*.dmp
**/network/admin/tnsnames.ora
**/*.trc
**/*.trm

# 7. Project-specific generated files
**/next-env.d.ts

# 8. Temporary files
**/tmp/**
**/temp/**
**/.gemini/**
**/.aimact/**
**/package-lock.json
